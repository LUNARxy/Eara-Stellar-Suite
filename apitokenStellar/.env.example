# Template de variables de entorno — sin valores reales (ver SOP_Seguridad_Infisical_Credenciales).
# Copiar a .env (gitignored) y rellenar con valores reales de desarrollo.

IS_DEVELOPMENT_ENVIROMENT=true
DEV_EMAILS=

SQLALCHEMY_DATABASE_URL=

HVAC_URL=http://localhost:8200
HVAC_USER=api
HVAC_PASSWORD=

SLUG_PORJECT_RESIGN=

STELLAR_HORIZON_URL=https://horizon.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
COMPLIANT_ID_CONTRACT_ID=
STELLAR_ADMIN_SECRET_KEY=

# JWT_SECRET_KEY: obligatorio desde 2026-10-16 (antes hardcodeado en api/v1/deps.py,
# hallazgo #1 de la remediación de seguridad de Stellar Suite). Generar con:
#   openssl rand -hex 32
JWT_SECRET_KEY=

LOCK_FILE=
LOCK_FILE_KYC=

AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION_NAME=us-east-1
